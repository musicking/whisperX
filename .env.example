WHISPERX_API_ENVIRONMENT=local
WHISPERX_API_HOST=0.0.0.0
WHISPERX_API_PORT=8000
WHISPERX_API_SHOW_DOCS=true
WHISPERX_API_DATA_DIR=./data
WHISPERX_API_API_KEY=
WHISPERX_API_SYNC_VIA_WORKER=true
WHISPERX_API_SYNC_TIMEOUT_SECONDS=900

WHISPERX_API_MODEL_NAME=small
WHISPERX_API_ALLOWED_MODELS=["tiny","base","small","medium","large-v3"]
WHISPERX_API_DEVICE=cuda
WHISPERX_API_DEVICE_INDEX=0
WHISPERX_API_COMPUTE_TYPE=default
WHISPERX_API_BATCH_SIZE=8
WHISPERX_API_MAX_LOADED_ASR_MODELS=1
WHISPERX_API_MAX_LOADED_ALIGN_MODELS=3
WHISPERX_API_MODEL_CACHE_ONLY=false
WHISPERX_API_PRELOAD_MODEL=false

# Required only for speaker diarization. Never send this token in an API request.
WHISPERX_API_HF_TOKEN=
WHISPERX_API_DIARIZE_MODEL=pyannote/speaker-diarization-community-1
WHISPERX_API_ALLOW_SPEAKER_EMBEDDINGS=false

WHISPERX_API_REQUIRE_WORKER_FOR_READINESS=true
WHISPERX_API_WORKER_POLL_SECONDS=0.5
