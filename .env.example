# 所有配置都有默认值；这里只列出常用项，按需修改即可。
# 默认监听 0.0.0.0，允许内部服务通过网络访问。
WHISPERX_API_PORT=7865

# 默认转写模型；请求也可以通过 model 参数选择允许的模型。
WHISPERX_API_MODEL_NAME=small

# 推理设备：cuda 使用 NVIDIA GPU，cpu 使用 CPU。
WHISPERX_API_DEVICE=cuda
# CPU 部署时可取消下一行注释，使用 int8 降低内存占用。
# WHISPERX_API_COMPUTE_TYPE=int8

# 同时执行推理的实例数。每个实例独立加载模型，提高并发会增加显存占用。
# 超出此数量的请求会异步等待空闲实例。
WHISPERX_API_INFERENCE_CONCURRENCY=1

# UTF-8 日志文件，路径相对于启动目录；目录自动创建。
# 默认每个文件最多 10 MiB，保留 5 个备份，无需另行配置。
WHISPERX_API_LOG_FILE=./data/logs/api.log

# 仅使用说话人区分时需要 Hugging Face token，并先接受对应模型的使用条款。
# WHISPERX_API_HF_TOKEN=
# 仅需要返回说话人向量时开启；默认关闭。
# WHISPERX_API_ALLOW_SPEAKER_EMBEDDINGS=true
