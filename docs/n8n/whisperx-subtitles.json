{
  "name": "WhisperX 音频生成字幕",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whisperx-subtitles",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "5ba5e110-9a6c-43af-81f2-4b8c64e1f189",
      "name": "Audio Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "176ea334-c198-47ae-a950-ad85011c4cc6",
      "notes": "接收 multipart/form-data。音频文件字段必须为 file；可选 language（默认 zh）、document_text（原稿文字）。不要开启 Binary Data，它会把整个 multipart 请求当作文件。"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.1.33:7865/v1/audio/subtitles",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": "={{ [\n  { parameterType: 'formBinaryData', name: 'file', inputDataFieldName: 'file' },\n  { parameterType: 'formData', name: 'language', value: $json.body.language || 'zh' },\n  { parameterType: 'formData', name: 'response_format', value: 'srt' },\n  { parameterType: 'formData', name: 'max_line_width', value: '30' },\n  { parameterType: 'formData', name: 'max_line_count', value: '1' },\n  ...($json.body.document_text?.trim()\n    ? [{ parameterType: 'formData', name: 'document_text', value: $json.body.document_text }]\n    : [])\n] }}"
        },
        "options": {
          "timeout": 900000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "file",
              "outputPropertyName": "subtitles"
            }
          }
        }
      },
      "id": "827c3223-9639-4afd-ae93-a8eaf476aa78",
      "name": "Generate Subtitles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [300, 0],
      "notes": "直接调用内部 WhisperX API，不使用认证。原稿为空时不发送 document_text，以避免空原稿触发 422。保留 API 状态码和完整响应，成功时为 SRT，API 错误时为 JSON。"
    },
    {
      "parameters": {
        "respondWith": "binary",
        "responseDataSource": "set",
        "inputFieldName": "subtitles",
        "options": {
          "responseCode": "={{ $json.statusCode }}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "={{ $json.headers['content-type'] }}"
              },
              {
                "name": "Content-Disposition",
                "value": "={{ $json.statusCode >= 400 ? 'inline; filename=error.json' : 'attachment; filename=subtitles.srt' }}"
              }
            ]
          }
        }
      },
      "id": "24b56ad6-87e4-4e59-a2c2-d54e4e89a3be",
      "name": "Return SRT",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [600, 0],
      "notes": "成功时返回可下载的 subtitles.srt；API 返回 422/503 等状态时原样转发状态和 JSON 错误内容。"
    }
  ],
  "connections": {
    "Audio Webhook": {
      "main": [[{"node": "Generate Subtitles", "type": "main", "index": 0}]]
    },
    "Generate Subtitles": {
      "main": [[{"node": "Return SRT", "type": "main", "index": 0}]]
    }
  },
  "settings": {"executionOrder": "v1", "executionTimeout": 900},
  "active": false,
  "pinData": {},
  "tags": []
}
