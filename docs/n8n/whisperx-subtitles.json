{
  "name": "WhisperX 音频生成字幕",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whisperx/subtitles",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "5ba5e110-9a6c-43af-81f2-4b8c64e1f189",
      "name": "Audio Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "176ea334-c198-47ae-a950-ad85011c4cc6",
      "notes": "接收 multipart/form-data。音频文件字段必须为 file；可选 language（默认 zh）、document_text（原稿文字）。不要开启 Binary Data，它会把整个 multipart 请求当作文件。"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "635b4eab-72d6-4d38-85aa-4a249ea45076",
              "leftValue": "={{ ($json.body.document_text || '').trim() }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f408f3cf-485d-4efc-ad70-46635cb7e250",
      "name": "Has Document",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        300,
        0
      ],
      "notes": "原稿非空走 true；未提供或空白走 false。保留音频 Binary.file。"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.1.33:7865/v1/audio/subtitles",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "file"
            },
            {
              "parameterType": "formData",
              "name": "language",
              "value": "={{ $json.body.language || 'zh' }}"
            },
            {
              "parameterType": "formData",
              "name": "response_format",
              "value": "srt"
            },
            {
              "parameterType": "formData",
              "name": "max_line_width",
              "value": "30"
            },
            {
              "parameterType": "formData",
              "name": "max_line_count",
              "value": "1"
            },
            {
              "parameterType": "formData",
              "name": "document_text",
              "value": "={{ $json.body.document_text }}"
            }
          ]
        },
        "options": {
          "timeout": 900000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text",
              "outputPropertyName": "srtContent"
            }
          }
        }
      },
      "id": "50e9f29d-c931-4385-8fcf-d4a63e86b9e1",
      "name": "Generate Document Subtitles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        -150
      ],
      "notes": "有原稿：在原生表单字段中增加 document_text。音频仍从 Binary.file 读取。 API 响应按普通文本读取到 srtContent，不生成二进制字幕文件。"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.1.33:7865/v1/audio/subtitles",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "file"
            },
            {
              "parameterType": "formData",
              "name": "language",
              "value": "={{ $json.body.language || 'zh' }}"
            },
            {
              "parameterType": "formData",
              "name": "response_format",
              "value": "srt"
            },
            {
              "parameterType": "formData",
              "name": "max_line_width",
              "value": "30"
            },
            {
              "parameterType": "formData",
              "name": "max_line_count",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 900000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text",
              "outputPropertyName": "srtContent"
            }
          }
        }
      },
      "id": "827c3223-9639-4afd-ae93-a8eaf476aa78",
      "name": "Generate Subtitles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        150
      ],
      "notes": "无原稿：使用原生表单字段发送 file 音频及字幕选项。保留完整响应和 API 状态码。 API 响应按普通文本读取到 srtContent，不生成二进制字幕文件。"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ Number($json.statusCode) >= 400 ? { success: false, error: $json.srtContent } : { success: true, srtContent: $json.srtContent } }}",
        "options": {
          "responseCode": "={{ Number($json.statusCode) }}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "24b56ad6-87e4-4e59-a2c2-d54e4e89a3be",
      "name": "Respond SRT JSON",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        900,
        0
      ],
      "notes": "与 ComfyUI 附件一致，成功返回 {success:true,srtContent:完整SRT文本}，失败返回 {success:false,error:API错误文本}。保留 API 状态码，无文件下载响应。"
    }
  ],
  "connections": {
    "Audio Webhook": {
      "main": [
        [
          {
            "node": "Has Document",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Document": {
      "main": [
        [
          {
            "node": "Generate Document Subtitles",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Generate Subtitles",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Document Subtitles": {
      "main": [
        [
          {
            "node": "Respond SRT JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Subtitles": {
      "main": [
        [
          {
            "node": "Respond SRT JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 900
  },
  "active": false,
  "pinData": {},
  "tags": []
}
